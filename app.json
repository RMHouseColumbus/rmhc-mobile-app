{
  "expo": {
    "name": "RMHC App",
    "slug": "RMHCApp",
    "owner": "rmhc",
    "version": "1.3.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rmhc",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "tel",
          "telprompt"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "org.rmhc.rmhcmobileapp"
    },
    "android": {
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#8EE7F8"
      },
      "package": "org.rmhc.rmhcmobileapp"
    },
    "extra": {
      "eas": {
        "projectId": "ba791d2b-49aa-468e-b4be-059ddd3c6f41"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFDE9",
          "imageWidth": 280,
          "android": {
            "imageWidth": 200
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
